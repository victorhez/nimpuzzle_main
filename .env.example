# ============================================================
# NimPuzzle — Production & Local Environment Configuration
# ============================================================
# Copy this file to `.env.local` for local development,
# or set these variables in your hosting provider's panel
# (Vercel, Railway, Fly.io, Render, etc.).

# ------------------------------------------------------------
# 1. DATABASE — REQUIRED
# ------------------------------------------------------------
# Postgres connection string. ANY managed Postgres provider works:
#   - Vercel Postgres       (vercel.com/docs/storage)
#   - Supabase              (supabase.com/database)
#   - Neon                  (neon.tech)
#   - Railway Postgres      (railway.app)
#   - Self-hosted Postgres
#
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
#
# NOTE: sslmode=require is MANDATORY for all cloud providers.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# ------------------------------------------------------------
# 2. NIMIQ NETWORK — REQUIRED
# ------------------------------------------------------------
# Which Nimiq network to operate on.
#   - TestAlbatross   = Testnet (use for staging / QA)
#   - MainAlbatross   = Mainnet  (use for production real money)
NIMIQ_NETWORK=TestAlbatross

# Public JSON-RPC endpoint for verifying transactions on-chain.
# You can use the public community endpoint, or run your own node:
#   - Public (community):  https://rpc.nimiqwatch.com
#   - Self-hosted:         http://your-node-ip:8648-1
#
# Production recommendation: Run your own node or use a dedicated
# RPC provider to avoid rate limits and downtime.
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# ------------------------------------------------------------
# 3. TREASURY WALLET — REQUIRED
# ------------------------------------------------------------
# The Nimiq address that RECEIVES all entry stakes from players.
# This MUST be a wallet you control. Create one via:
#   - Nimiq Hub / Wallet (hub.nimiq.com)
#   - Nimiq CLI: `nimiq account create`
#   - Nimiq Core: generate via SDK
#
# FORMAT: User-friendly Nimiq address with spaces, e.g.
#   NQ07 0000 0000 0000 0000 0000 0000 0000 0000
#
# ⚠️  PRODUCTION WARNING:
#   This is where all entry stake NIM flows. Keep the private key
#   of this address OFFLINE / COLD STORAGE. Do NOT put this private
#   key into any server env var. Only the payout hot wallet (below)
#   should be on the server.
NIMIQ_TREASURY_ADDRESS=NQXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX

# Publicly exposed copy of the treasury address. Shown to users in
# the browser mini-app SDK so they know where to send their stake.
# MUST match the value of NIMIQ_TREASURY_ADDRESS above.
NEXT_PUBLIC_NIMIQ_TREASURY_ADDRESS=NQXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX

# ------------------------------------------------------------
# 4. ENTRY STAKING AMOUNT
# ------------------------------------------------------------
# How much NIM each player must stake per daily puzzle entry.
# Default from the competition brief is 2 NIM.
# 1 NIM = 100,000 LUNA (smallest unit).
NIMIQ_ENTRY_NIM=2

# ------------------------------------------------------------
# 5. CRON SECRET — REQUIRED FOR SETTLEMENT
# ------------------------------------------------------------
# Long random string used to authenticate the Vercel Cron (or any
# external scheduler) that calls /api/cron/settle once per day
# to close yesterday's puzzle and payout winners.
#
# Generate a strong secret with:
#   openssl rand -hex 32
#
# In Vercel: set this as the "Authorization" bearer token in the
# Cron Job configuration. More info: vercel.com/docs/cron-jobs
#
# ⚠️  THIS IS SECURITY CRITICAL.
# If leaked, attackers could trigger premature payouts / settle
# runs. Rotate immediately if compromised.
CRON_SECRET=change-me

# ------------------------------------------------------------
# 6. PLATFORM REVENUE FEE
# ------------------------------------------------------------
# Fee taken from each daily prize pool BEFORE the remainder is
# split among winners. Expressed in basis points (bps).
#   100 bps = 1%
#   500 bps = 5%    (default from competition brief)
#  1000 bps = 10%
PLATFORM_FEE_BPS=500

# ------------------------------------------------------------
# 7. LIVE PAYMENTS TOGGLE
# ------------------------------------------------------------
# When set to "false", the app runs in DEMO MODE:
#   - No Nimiq wallet connection required
#   - No on-chain transactions are verified
#   - Everyone enters with a demo wallet
#   - Useful for local dev, UI testing, staging preview
#
# Set to "true" ONLY when deploying to production with a real
# treasury address and verified RPC endpoint.
NIMIQ_LIVE_PAYMENTS=false
NEXT_PUBLIC_LIVE_PAYMENTS=false

# ------------------------------------------------------------
# 8. PAYOUT HOT WALLET — REQUIRED FOR AUTOMATIC PAYOUTS
# ------------------------------------------------------------
# Private key (hex format) of a DEDICATED Nimiq wallet used ONLY
# for sending daily payouts to winners. This wallet is the ONLY
# private key that should ever live on the server / env vars.
#
# How to create one via Nimiq CLI:
#   nimiq account create
#
# Or via @nimiq/core:
#   const kp = Nimiq.KeyPair.generate()
#   console.log(kp.privateKey.toHex())   # This is the value below
#   console.log(kp.toAddress().toUserFriendlyAddress())  # Fund this address
#
# ⚠️  OPERATIONAL SECURITY REQUIREMENTS:
#   1. Create a FRESH wallet for payouts. NEVER use your personal wallet.
#   2. NEVER reuse the treasury wallet here. Keep treasury COLD.
#   3. Fund this wallet with a small working float only (e.g. 50-100 NIM).
#      Top it up periodically from your cold treasury.
#   4. If this key is ever compromised, IMMEDIATELY:
#      - Sweep all remaining funds out of this wallet
#      - Generate a new key
#      - Rotate the env var in your hosting provider
#   5. If left EMPTY, settlement will still run but payouts will be
#      queued as "status = 'queued'" in the payouts table for you
#      to process manually via a separate script / cold wallet.
NIMIQ_PAYOUT_PRIVATE_KEY=

# ============================================================
# DEPLOYMENT CHECKLIST — PRODUCTION GO-LIVE
# ============================================================
#
#  [ ] 1. Postgres database created, DATABASE_URL set with sslmode=require
#  [ ] 2. NIMIQ_NETWORK = MainAlbatross  (remove TestAlbatross)
#  [ ] 3. NIMIQ_RPC_URL pointing to reliable mainnet RPC / self-hosted node
#  [ ] 4. NIMIQ_TREASURY_ADDRESS + NEXT_PUBLIC_NIMIQ_TREASURY_ADDRESS = your real treasury
#  [ ] 5. CRON_SECRET generated (openssl rand -hex 32) and set in Vercel Cron
#  [ ] 6. NIMIQ_LIVE_PAYMENTS=true, NEXT_PUBLIC_LIVE_PAYMENTS=true
#  [ ] 7. NIMIQ_PAYOUT_PRIVATE_KEY set to a funded hot-wallet
#  [ ] 8. Vercel Cron job configured to hit /api/cron/settle daily at 00:05 UTC
#  [ ] 9. Smoke-test: enter with 1 NIM, solve, trigger settle manually with curl:
#         curl -H "Authorization: Bearer YOUR_CRON_SECRET" https://your-domain/api/cron/settle
#  [ ] 10. Verify payout tx appears on Nimiq chain for the solver wallet
#  [ ] 11. Treasury balance reconcile: confirm 5% fee landed in treasury addr
#
# ============================================================
